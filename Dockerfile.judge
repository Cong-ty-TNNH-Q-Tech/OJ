FROM dmoj/runtimes-tier1:latest

# Install Python and build dependencies for the DMOJ judge
RUN apt-get update && apt-get install -y \
    python3-dev python3-pip python3-venv \
    gcc g++ make cmake git \
    libseccomp-dev \
    && rm -rf /var/lib/apt/lists/*

# Create a virtual environment and install the judge
RUN python3 -m venv /judge-env
ENV PATH="/judge-env/bin:$PATH"

RUN pip3 install --no-cache-dir cython
RUN pip3 install --no-cache-dir dmoj

# Override the default entrypoint
ENTRYPOINT ["dmoj"]
